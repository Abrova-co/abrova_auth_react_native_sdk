{
  "name": "@abrova/auth-react-native",
  "version": "0.4.0",
  "description": "Abrova Auth SDK for React Native - hosted sign-in for your users",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/commonjs/index.js"
    },
    "./ui": {
      "types": "./lib/typescript/ui.d.ts",
      "default": "./lib/commonjs/ui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "ui",
    "!lib/**/__tests__"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs",
    "build": "bob build",
    "pretypecheck": "node scripts/gen-version.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib",
    "pretest": "node scripts/gen-version.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "react-native",
    "auth",
    "authentication",
    "sign-in",
    "abrova",
    "abrova-auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abrova-co/abrova_auth_react_native_sdk.git"
  },
  "author": "Abrova <support@abrova.ir>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Abrova-co/abrova_auth_react_native_sdk/issues"
  },
  "homepage": "https://abrova.ir/cloud/abrova-auth",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*",
    "react-native-keychain": "*"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-keychain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.3.0",
    "react": "^19.2.3",
    "react-native": "^0.84.1",
    "react-native-builder-bob": "^0.23.0",
    "react-test-renderer": "^19.2.3",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
